{
  "name": "cloudtun",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc --noEmit && vite build -c scripts/vite.config.ts",
    "build-apk": "tauri android build --apk --target aarch64",
    "dev": "vite dev -c scripts/vite.config.ts",
    "lint": "tsc --noEmit && oxlint --type-aware && oxfmt --check",
    "lint-fix": "oxfmt && oxlint --type-aware --fix",
    "lint-staged": "lint-staged",
    "prepare": "husky",
    "preview": "vite preview -c scripts/vite.config.ts",
    "test": "bun test --isolate"
  },
  "dependencies": {
    "@ant-design/colors": "^8.0.1",
    "@tauri-apps/api": "^2.12.5",
    "@tauri-apps/plugin-autostart": "~2.7.0",
    "@tauri-apps/plugin-clipboard-manager": "^2.5.0",
    "@tauri-apps/plugin-http": "~2.9.0",
    "@tauri-apps/plugin-os": "~2.4.0",
    "@tauri-apps/plugin-store": "~2.5.1",
    "jinge": "^4.2.2",
    "jinge-antd": "file:../jinge-antd",
    "qrcode": "^1.5.4",
    "ws": "^8.23.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@iconify-json/ant-design": "^1.2.9",
    "@iconify/tailwind4": "^1.2.3",
    "@tailwindcss/vite": "^4.3.5",
    "@tauri-apps/cli": "^2.12.5",
    "@types/bun": "^1.4.4",
    "@types/node": "^26.6.6",
    "@types/qrcode": "^1.5.6",
    "@types/ws": "^8.18.2",
    "@types/yauzl": "^3.4.0",
    "bun": "^1.4.4",
    "date-fns": "^4.4.0",
    "husky": "^9.1.7",
    "internal-ip": "^9.0.0",
    "jinge-compiler": "^4.2.1",
    "lint-staged": "^17.6.1",
    "oxfmt": "^0.79.0",
    "oxlint": "^1.94.0",
    "oxlint-tsgolint": "^7.0.2007",
    "postcss": "^8.5.33",
    "sass-embedded": "^1.108.2",
    "tailwindcss": "^4.3.5",
    "type-fest": "^6.0.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vite-plugin-minipic": "^1.3.2",
    "yauzl": "^3.4.0"
  },
  "lint-staged": {
    "*.{js,ts}": [
      "oxlint --type-aware --fix",
      "oxfmt"
    ]
  }
}
