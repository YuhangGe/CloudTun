{
  "name": "cloudtun",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc && vite build -c scripts/vite.config.ts",
    "build-apk": "tauri android build --apk --target aarch64",
    "dev": "vite dev -c scripts/vite.config.ts",
    "lint": "tsc --noEmit && oxlint --type-aware && oxfmt --check",
    "lint-fix": "oxfmt && oxlint --type-aware --fix",
    "lint-staged": "lint-staged",
    "prepare": "husky",
    "preview": "vite preview -c scripts/vite.config.ts"
  },
  "dependencies": {
    "@ant-design/colors": "^8.0.1",
    "@tauri-apps/api": "^2.10.1",
    "@tauri-apps/plugin-autostart": "~2.5.1",
    "@tauri-apps/plugin-clipboard-manager": "^2.3.2",
    "@tauri-apps/plugin-http": "~2.5.8",
    "@tauri-apps/plugin-os": "~2.3.2",
    "@tauri-apps/plugin-store": "~2.4.2",
    "jinge": "^4.1.7",
    "jinge-antd": "file:..\\jinge-antd",
    "qrcode": "^1.5.4",
    "ws": "^8.20.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.11",
    "@iconify/json": "^2.2.462",
    "@iconify/tailwind4": "^1.2.3",
    "@tailwindcss/vite": "^4.2.2",
    "@tauri-apps/cli": "^2.10.1",
    "@types/bun": "^1.3.12",
    "@types/node": "^25.6.0",
    "@types/qrcode": "^1.5.6",
    "@types/ws": "^8.18.1",
    "@types/yauzl": "^2.10.3",
    "@typescript/native-preview": "7.0.0-dev.20260413.1",
    "bun": "^1.3.12",
    "date-fns": "^4.1.0",
    "husky": "^9.1.7",
    "internal-ip": "^9.0.0",
    "jinge-compiler": "^4.1.9",
    "lint-staged": "^16.4.0",
    "oxfmt": "^0.45.0",
    "oxlint": "^1.60.0",
    "oxlint-tsgolint": "^0.20.0",
    "postcss": "^8.5.9",
    "sass-embedded": "^1.99.0",
    "tailwindcss": "^4.2.2",
    "type-fest": "^5.5.0",
    "vite": "^8.0.8",
    "vite-plugin-minipic": "^1.3.2",
    "yauzl": "^3.3.0"
  },
  "lint-staged": {
    "*.{js,ts}": [
      "oxlint --type-aware --fix",
      "oxfmt"
    ]
  },
  "pnpm": {
    "overrides": {
      "vite": "^8.0.0-beta.16"
    }
  }
}
