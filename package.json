{
  "name": "cloudtun",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite dev -c scripts/vite.config.ts",
    "build": "tsc && vite build -c scripts/vite.config.ts",
    "build-apk": "tauri android build --apk --target aarch64",
    "preview": "vite preview -c scripts/vite.config.ts",
    "lint-fix": "oxlint --type-aware --fix && biome format --fix",
    "lint": "tsc --noEmit && oxlint --type-aware && biome format",
    "lint-staged": "lint-staged",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{js,ts}": [
      "oxlint --type-aware --fix",
      "biome format --fix"
    ]
  },
  "dependencies": {
    "@ant-design/colors": "^8.0.1",
    "@tauri-apps/api": "^2.10.1",
    "@tauri-apps/plugin-autostart": "~2.5.1",
    "@tauri-apps/plugin-clipboard-manager": "^2.3.2",
    "@tauri-apps/plugin-http": "~2.5.7",
    "@tauri-apps/plugin-os": "~2.3.2",
    "@tauri-apps/plugin-store": "~2.4.2",
    "jinge": "^4.1.7",
    "jinge-antd": "file:../jinge-antd",
    "qrcode": "^1.5.4",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.5",
    "@iconify/json": "^2.2.444",
    "@iconify/tailwind4": "^1.2.1",
    "@tailwindcss/vite": "^4.2.1",
    "@tauri-apps/cli": "^2.10.0",
    "@types/bun": "^1.3.10",
    "@types/node": "^25.3.3",
    "@types/qrcode": "^1.5.6",
    "@types/yauzl": "^2.10.3",
    "@typescript/native-preview": "7.0.0-dev.20260303.1",
    "bun": "^1.3.10",
    "date-fns": "^4.1.0",
    "husky": "^9.1.7",
    "internal-ip": "^9.0.0",
    "jinge-compiler": "^4.1.9",
    "lint-staged": "^16.3.2",
    "oxlint": "^1.51.0",
    "oxlint-tsgolint": "^0.16.0",
    "postcss": "^8.5.8",
    "sass-embedded": "^1.97.3",
    "tailwindcss": "^4.2.1",
    "type-fest": "^5.4.4",
    "vite": "8.0.0-beta.16",
    "vite-plugin-minipic": "^1.3.2",
    "vite-tsconfig-paths": "^6.1.1",
    "yauzl": "^3.2.0"
  },
  "pnpm": {
    "overrides": {
      "vite": "^8.0.0-beta.16"
    }
  }
}
